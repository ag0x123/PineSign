  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@ethersphere/bee-js": "^11.1.1",
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "express": "^4.21.0",
    "viem": "^2.56.3"
  },
