# Everything this deployment needs. Nothing here is baked into the code.

# ---- gateway ----
PORT=8788
# Loopback when a reverse proxy is in front, which it should be.
HOST=0.0.0.0
# Where users reach this server. Used for the links in emails.
PUBLIC_ORIGIN=https://example.com

# How long a transfer lives before it lapses (default 3 days)
TRANSFER_TTL_MS=259200000

# ---- sign-in ----
# Resend. The domain in MAIL_FROM must be verified with them first.
RESEND_API_KEY=
MAIL_FROM=PineSign <noreply@example.com>

# The passkey's relying party. Deliberately a subdomain: a credential scoped
# here works on this host and anything under it, but NOT on the parent — so
# the lander cannot ask for an assertion and read the derived key out of it.
PASSKEY_RP_ID=id.example.com
PASSKEY_RP_NAME=PineSign

# The published sign-in pages, comma separated. A ceremony driven from any
# other origin is refused even with a valid challenge.
SIGNIN_ORIGINS=https://v1.id.example.com

# The sign-in page the app opens. Compiled into the app's bundles at build time.
SIGNIN_PAGE_URL=https://v1.id.example.com/

# Origins allowed to drive the sign-in page, comma separated. Compiled into the
# sign-in bundle: a page on any other origin gets no reply from it at all.
APP_ORIGINS=https://example.com,https://www.example.com

# HMAC keys. Generate with: openssl rand -hex 32
# Unset, they are generated once into .storage/secrets.json — fine for one box,
# but set them so they survive a lost disk and match across replicas. Losing
# EMAIL_HASH_KEY makes every email hash already published unmatchable.
PASSKEY_CHALLENGE_SECRET=
EMAIL_HASH_KEY=

# ---- chain ----
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Mainnet, read-only: used to check a name is not already owned for real
MAINNET_RPC=https://ethereum-rpc.publicnode.com
# Receipt contract, written here by the setup page after it deploys
RECEIPTS_ADDRESS=

# ---- swarm ----
# Unset, the gateway stores blobs locally so the flow still runs.
BEE_URL=http://localhost:1633
GNOSIS_RPC=https://rpc.gnosischain.com
BEE_PASSWORD=change-me
# The admin panel buys a batch and records it in .storage/config.json; set it
# here only to reuse a batch you already own.
POSTAGE_BATCH_ID=
